# PostgreSQL connection string. Keep real credentials in .env or deployment secrets.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# Server-side source for the ENTSO-E Streamlit dashboard.
STREAMLIT_ENTSOE_URL=

# Server-only connection to the private energy-bot service (no trailing /api).
BOT_SERVICE_URL=http://energy-bot.railway.internal:8080
# Same random secret as BOT_SERVICE_TOKEN on energy-bot. At least 32 characters.
BOT_SERVICE_TOKEN=

# Server-only data collectors. May also live in ignored .env.data.
# Existing sibling energy-streamlit/.env ENTSOE_API_TOKEN is reused locally if absent.
ENTSOE_API_TOKEN=
GIE_API_KEY=
CDSAPI_URL=https://cds.climate.copernicus.eu/api
CDSAPI_KEY=

# Hosted app: local-agent reads market data through the outbound data-computer agent.
# Default postgres reads market data from this process's own DATABASE_URL.
DATA_BACKEND=postgres
LOCAL_DATA_AGENT_TOKEN=
# Local agent only: URL of the hosted portal. Never sent to browsers with the token.
LOCAL_DATA_CLOUD_URL=https://energy-production-c147.up.railway.app
